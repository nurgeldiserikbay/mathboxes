{"name":"Math Boxes","short_name":"Math Boxes","start_url":"./index.html?fullscreen=true","display":"fullscreen","background_color":"#fff","lang":"en","scope":"https://nurgeldiserikbay.github.io/","id":"com.thelightcome.mathboxes","description":"Solve exciting equations with missing numbers, choose the correct answer from four options, and earn points! The game features 8 levels, each focusing on a unique mathematical operation: addition, subtraction, multiplication, division, exponentiation, square root, logarithm, and a random mix of all operations. \n Test your skills, beat the timer, and prove you're a math master!","orientation":"portrait","theme_color":"#fff","protocol_handlers":[],"icons":[{"src":"./icons/favicon-16x16.png","type":"image/png","sizes":"16x16"},{"src":"./icons/favicon-32x32.png","type":"image/png","sizes":"32x32"},{"src":"./icons/mstile-70x70.png","type":"image/png","sizes":"128x128"},{"src":"./icons/mstile-144x144.png","type":"image/png","sizes":"144x144"},{"src":"./icons/mstile-150x150.png","type":"image/png","sizes":"270x270"},{"src":"./icons/mstile-310x150.png","type":"image/png","sizes":"558x270"},{"src":"./icons/mstile-310x310.png","type":"image/png","sizes":"558x558"},{"src":"./icons/android-chrome-192x192.png","type":"image/png","sizes":"192x192"},{"src":"./icons/android-chrome-512x512.png","type":"image/png","sizes":"512x512"},{"src":"./icons/apple-touch-icon.png","type":"image/png","sizes":"180x180"}],"display_override":["window-controls-overlay"],"screenshots":[{"src":"./screenshots/narrow-1.png","type":"image/png","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-2.png","type":"image/png","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-3.png","type":"image/png","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-4.png","type":"image/png","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-5.png","type":"image/png","sizes":"406x720","form_factor":"narro