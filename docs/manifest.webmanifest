{"name":"Math Boxes","short_name":"Math Boxes","start_url":"./index.html?fullscreen=true","display":"fullscreen","background_color":"#100c24","lang":"en","scope":"https://nurgeldiserikbay.github.io/","id":"com.thelightcome.mathboxes","description":"Solve the equation, build the floor, climb higher. Every answer becomes the start of the next sum, so the tower is one long chain of mental arithmetic: add, subtract, multiply, divide. The difficulty follows you, not the floor number. Checkpoints hold what you have built, a mistake burns three floors, and the only score that matters is how high you got last time.","orientation":"portrait","theme_color":"#100c24","protocol_handlers":[],"icons":[{"src":"./icons/favicon-16x16.png","type":"image/png","sizes":"16x16"},{"src":"./icons/favicon-32x32.png","type":"image/png","sizes":"32x32"},{"src":"./icons/android-chrome-192x192.png","type":"image/png","sizes":"192x192"},{"src":"./icons/android-chrome-512x512.webp","type":"image/webp","sizes":"512x512"},{"src":"./icons/apple-touch-icon.png","type":"image/png","sizes":"180x180"}],"display_override":["window-controls-overlay"],"screenshots":[{"src":"./screenshots/narrow-1.webp","type":"image/webp","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-2.webp","type":"image/webp","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-3.webp","type":"image/webp","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-4.webp","type":"image/webp","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/narrow-5.webp","type":"image/webp","sizes":"406x720","form_factor":"narrow"},{"src":"./screenshots/wide-1.webp","type":"image/webp","sizes":"1024x640","form_factor":"wide"},{"src":"./screenshots/wide-2.webp","type":"image/webp","sizes":"1024x640","form_factor":"wide"},{"src":"./screenshots/wide-3.webp","type":"image/webp","sizes":"1024x640","form_factor":"wide"},{"src":"./screenshots/wide-4.webp","type":"image/webp","sizes":"1024x601"